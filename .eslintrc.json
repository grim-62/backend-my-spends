{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-underscore-dangle": "off",
    "func-names": "off",
    "object-shorthand": "off",
    "consistent-return": "off",
    "no-shadow": "off",
    "prefer-destructuring": "off",
    "no-param-reassign": [
      "error",
      {
        "props": false
      }
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "logs/",
    "coverage/"
  ]
}
